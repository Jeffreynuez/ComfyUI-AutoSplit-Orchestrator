    "face":             ["head fa"],
    "hair":             ["hair .*", "ponytail.*"],
    "hair_front":       ["hair front \\d fa", "hair top fa", "hair section \\d fa", "ponytail.*"],
    "hair_back":        ["hair back section \\d fa"],
    "torso":            ["torso fa", "neck fa", "torso upper leg r fa"],
    "jacket":           ["jacket l fa", "jacket r fa", "jacket back fa"],
    "skirt":            ["skirt fa", "skirt back fa"],
    "green sash":       ["skirt sash fa"],
    "under shirt":      ["shirt fa"],
    "left arm":         ["left arms (upper|lower) fa", "left shoulders fa", "left jacket arms (upper|lower) fa", "left jacket cuffs fa"],
    "right arm":        ["right arms (upper|lower) fa", "right shoulders fa", "right jacket arms (upper|lower) fa", "right jacket cuffs fa"],
    "left hand":        ["left hand fa"],
    "right hand":       ["right hand fa"],
    "left leg":         ["left legs (upper|mid|lower) fa"],
    "right leg":        ["right legs (upper|mid|lower) fa"],
    "left foot":        ["left foot fa"],
    "right foot":       ["right foot fa"],
    "left shin brace":  ["left leg brace (back )?fa"],
    "right shin brace": ["right leg brace (back )?fa"],
    "left eye":         ["left eyeball fa", "left iris fa"],
    "right eye":        ["right eyeball fa", "right iris fa"],
    "left iris":        ["left iris fa"],
    "right iris":       ["right iris fa"],
    "eyebrow_left":     ["left eyebrow fa"],
    "eyebrow_right":    ["right eyebrow fa"],
    "nose":             ["nose fa"],
    "lips":             ["upper lips fa", "mid lips fa"],
    "bottom lips":      ["lower lips fa"],
    "mouth":            ["mouth fa", "(upper|lower) teeth fa", "(upper|mid|lower) lips fa"]
